+fn copy_text_to_clipboard(text: &str) -> Result<()> {
+    use whisrs::input::clipboard::ClipboardOps;
+    use whisrs::input::ClipboardHandler;
+
+    let clipboard = ClipboardOps::detect();
+    clipboard
+        .set_text(text)
+        .context("failed to copy text to clipboard")
