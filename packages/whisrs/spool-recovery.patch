+        (None, false) => {
+            return Response::Error {
+                message: "spool retry: pass <id> or --all".into(),
+            };
+        }
+    };
+
+    if paths.is_empty() {
+        return Response::Spool {
+            entries: Vec::new(),
+            retried: Vec::new(),
+            dropped: Vec::new(),
+        };
+    }
+
+    let transcription_config = build_transcription_config(&context.config);
+    let backend_name = context.config.general.backend.clone();
+    let language = context.config.general.language.clone();
+    let mut retried: Vec<SpoolRetryResult> = Vec::with_capacity(paths.len());
+
+    for path in paths {
+        let id = match spool::spool_id_for_path(&path) {
+            Some(id) => id,
+            None => continue,
+        };
+        let bytes = match std::fs::read(&path) {
+            Ok(b) => b,
+            Err(e) => {
+                retried.push(SpoolRetryResult {
+                    id,
+                    text: None,
+                    error: Some(format!("read failed: {e}")),
+                });
+                continue;
+            }
+        };
+        let started = std::time::Instant::now();
+        let outcome = context
+            .transcription_backend
+            .transcribe(&bytes, &transcription_config)
+            .await;
+        match outcome {
+            Ok(text) if !text.is_empty() => {
+                let duration_secs = started.elapsed().as_secs_f64();
+                save_history_entry(&text, &backend_name, &language, duration_secs);
+                copy_transcript_to_clipboard(&text).await;
+                if let Err(e) = std::fs::remove_file(&path) {
+                    warn!(
+                        "retry succeeded but failed to delete spool file {:?}: {e}",
+                        path
+                    );
+                }
+                if !auto {
+                    info!("spool retry success: {id}");
+                }
+                retried.push(SpoolRetryResult {
+                    id,
+                    text: Some(text),
+                    error: None,
+                });
+            }
+            Ok(_) => {
+                retried.push(SpoolRetryResult {
+                    id,
+                    text: None,
+                    error: Some("transcription returned empty text".into()),
+                });
+            }
+            Err(e) => {
+                if !auto {
+                    warn!("spool retry failed for {id}: {e}");
+                }
+                retried.push(SpoolRetryResult {
+                    id,
+                    text: None,
+                    error: Some(format!("{e:#}")),
+                });
+            }
+        }
+    }
+
+    Response::Spool {
+        entries: Vec::new(),
+        retried,
+        dropped: Vec::new(),
+    }
+}
+
+async fn handle_spool_drop(id: Option<String>, all: bool) -> Response {
+    let paths: Vec<std::path::PathBuf> = match (&id, all) {
+        (Some(id), false) => match spool::spool_path_for_id(id) {
+            Some(p) => vec![p],
+            None => {
+                return Response::Error {
+                    message: format!("no spool entry with id '{id}'"),
+                };
+            }
+        },
+        (None, true) => spool::list_spool_paths(),
+        (Some(_), true) => {
+            return Response::Error {
+                message: "spool drop: pass --all OR <id>, not both".into(),
+            };
+        }
+        (None, false) => {
+            return Response::Error {
+                message: "spool drop: pass <id> or --all".into(),
+            };
+        }
+    };
+
+    let mut dropped: Vec<String> = Vec::with_capacity(paths.len());
+    for path in paths {
+        let id = match spool::spool_id_for_path(&path) {
+            Some(id) => id,
+            None => continue,
+        };
+        if let Err(e) = std::fs::remove_file(&path) {
+            warn!("failed to drop spool file {:?}: {e}", path);
+            continue;
+        }
+        dropped.push(id);
+    }
+    Response::Spool {
+        entries: Vec::new(),
+        retried: Vec::new(),
+        dropped,
+    }
+}
