+/// Send a Spool-* command and unwrap the daemon's `Spool` response.
+async fn send_spool_command(
+    cmd: Command,
+) -> anyhow::Result<(Vec<SpoolEntry>, Vec<SpoolRetryResult>, Vec<String>)> {
+    let path = socket_path();
+    let mut stream = UnixStream::connect(&path)
+        .await
+        .map_err(|e| anyhow::anyhow!("connect to {}: {e}", path.display()))?;
+    let encoded = encode_message(&cmd)?;
+    stream.write_all(&encoded).await?;
+    stream.shutdown().await?;
+
+    let response: Response = read_message(&mut stream).await?;
+    match response {
+        Response::Spool {
+            entries,
+            retried,
+            dropped,
+        } => Ok((entries, retried, dropped)),
+        Response::Error { message } => Err(anyhow::anyhow!("daemon: {message}")),
+        Response::Ok { .. } => Err(anyhow::anyhow!(
+            "daemon returned Ok for a spool command — protocol mismatch"
+        )),
+        Response::History { .. } => Err(anyhow::anyhow!(
+            "daemon returned History for a spool command — protocol mismatch"
+        )),
+    }
+}
+
+async fn cmd_spool_list() -> anyhow::Result<()> {
+    let (entries, _, _) = send_spool_command(Command::SpoolList).await?;
+    let use_color = is_tty();
+    if entries.is_empty() {
+        if use_color {
+            println!("{GREEN}no spooled recordings{RESET}");
+        } else {
+            println!("no spooled recordings");
+        }
+        return Ok(());
+    }
+
+    println!("{} spooled recording(s):", entries.len());
+    for entry in entries {
+        let dur = entry
+            .duration_secs
+            .map(|s| format!("{:>5.1}s", s))
+            .unwrap_or_else(|| "    ?".into());
+        let kib = entry.size_bytes as f64 / 1024.0;
+        if use_color {
+            println!(
+                "  {BOLD}{}{RESET}  {dur}  {kib:>6.0} KiB  {}",
+                entry.id, entry.modified_at
+            );
+        } else {
+            println!("  {}  {dur}  {kib:>6.0} KiB  {}", entry.id, entry.modified_at);
+        }
+    }
