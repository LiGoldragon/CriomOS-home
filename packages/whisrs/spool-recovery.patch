+/// Build a `SpoolEntry` from a path on disk. Reads the WAV header for
+/// duration; missing/unreadable headers leave `duration_secs` as `None`
+/// rather than failing the listing entirely.
+fn spool_entry_from_path(path: &std::path::Path) -> Option<SpoolEntry> {
+    let id = spool::spool_id_for_path(path)?;
+    let metadata = std::fs::metadata(path).ok()?;
+    let size_bytes = metadata.len();
+    let modified_at = metadata
+        .modified()
+        .ok()
+        .map(|t| chrono::DateTime::<chrono::Local>::from(t).to_rfc3339())
+        .unwrap_or_default();
+    let duration_secs = hound::WavReader::open(path).ok().map(|r| {
+        let spec = r.spec();
+        r.duration() as f64 / f64::from(spec.sample_rate)
+    });
+    Some(SpoolEntry {
+        id,
+        path: path.to_path_buf(),
+        size_bytes,
+        modified_at,
+        duration_secs,
+    })
+}
+
+async fn handle_spool_list() -> Response {
+    let entries: Vec<SpoolEntry> = spool::list_spool_paths()
+        .iter()
+        .filter_map(|p| spool_entry_from_path(p))
+        .collect();
+    Response::Spool {
+        entries,
+        retried: Vec::new(),
+        dropped: Vec::new(),
+    }
+}
