+/// filename stem (e.g. `2026-05-07T15-04-18`); the daemon uses it to
+/// route retry/drop commands.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct SpoolEntry {
+    pub id: String,
+    pub path: PathBuf,
+    pub size_bytes: u64,
+    /// RFC3339 modification timestamp.
+    pub modified_at: String,
+    /// Approximate duration in seconds, decoded from the WAV header.
+    pub duration_secs: Option<f64>,
+}
+
+/// Outcome of a single spool-retry attempt. `text` carries the transcript
+/// when transcription succeeded; `error` carries the failure message
+/// when it didn't (so the entry stays on disk for another try).
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct SpoolRetryResult {
+    pub id: String,
