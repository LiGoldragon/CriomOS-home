diff --git a/src/level_stream.rs b/src/level_stream.rs
new file mode 100644
--- /dev/null
+++ b/src/level_stream.rs
@@ -0,0 +1,158 @@
+//! Push microphone level and daemon state to desktop-shell subscribers.
+
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use serde::Serialize;
+use tokio::io::AsyncWriteExt;
+use tokio::net::{UnixListener, UnixStream};
+use tokio::sync::watch;
+use tracing::{info, warn};
+
+use crate::State;
+
+const LEVEL_EVENT_INTERVAL: Duration = Duration::from_millis(33);
+
+#[derive(Debug, Clone, Copy, Serialize)]
+struct LevelEvent {
+    state: State,
+    level: f32,
+}
+
+/// Spawn the status-bar level stream server.
+///
+/// Each client connection receives the current state immediately, then receives
+/// newline-delimited JSON events whenever state or level changes.
+pub async fn spawn_level_stream(
+    state_rx: watch::Receiver<State>,
+    level_rx: watch::Receiver<f32>,
+) {
+    let path = level_stream_path();
+    if let Err(error) = prepare_socket(&path).await {
+        warn!("status bar level stream unavailable: {error:#}");
+        return;
+    }
+
+    let listener = match UnixListener::bind(&path) {
+        Ok(listener) => listener,
+        Err(error) => {
+            warn!(
+                "failed to bind status bar level stream at {}: {error}",
+                path.display()
+            );
+            return;
+        }
+    };
+
+    info!("status bar level stream listening at {}", path.display());
+    loop {
+        match listener.accept().await {
+            Ok((stream, _)) => {
+                let state_rx = state_rx.clone();
+                let level_rx = level_rx.clone();
+                tokio::spawn(async move {
+                    if let Err(error) = LevelStreamConnection::new(stream, state_rx, level_rx)
+                        .serve()
+                        .await
+                    {
+                        warn!("status bar level stream client ended: {error}");
+                    }
+                });
+            }
+            Err(error) => warn!("status bar level stream accept failed: {error}"),
+        }
+    }
+}
+
+fn level_stream_path() -> PathBuf {
+    std::env::var_os("XDG_RUNTIME_DIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(std::env::temp_dir)
+        .join("whisrs")
+        .join("level.sock")
+}
+
+async fn prepare_socket(path: &Path) -> anyhow::Result<()> {
+    if let Some(parent) = path.parent() {
+        tokio::fs::create_dir_all(parent).await?;
+    }
+    match tokio::fs::remove_file(path).await {
+        Ok(()) => {}
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+        Err(error) => return Err(error.into()),
+    }
+    Ok(())
+}
+
+struct LevelStreamConnection {
+    stream: UnixStream,
+    state_rx: watch::Receiver<State>,
+    level_rx: watch::Receiver<f32>,
+    state: State,
+    level: f32,
+    last_level_event_at: Instant,
+    last_sent_level: f32,
+}
+
+impl LevelStreamConnection {
+    fn new(
+        stream: UnixStream,
+        state_rx: watch::Receiver<State>,
+        level_rx: watch::Receiver<f32>,
+    ) -> Self {
+        let state = *state_rx.borrow();
+        let level = *level_rx.borrow();
+        let now = Instant::now();
+        Self {
+            stream,
+            state_rx,
+            level_rx,
+            state,
+            level,
+            last_level_event_at: now - LEVEL_EVENT_INTERVAL,
+            last_sent_level: level,
+        }
+    }
+
+    async fn serve(mut self) -> anyhow::Result<()> {
+        self.write_event().await?;
+        loop {
+            tokio::select! {
+                changed = self.state_rx.changed() => {
+                    if changed.is_err() {
+                        break;
+                    }
+                    self.state = *self.state_rx.borrow();
+                    self.write_event().await?;
+                }
+                changed = self.level_rx.changed() => {
+                    if changed.is_err() {
+                        break;
+                    }
+                    let now = Instant::now();
+                    let level = (*self.level_rx.borrow()).clamp(0.0, 1.0);
+                    self.level = level;
+                    let due = now.duration_since(self.last_level_event_at) >= LEVEL_EVENT_INTERVAL;
+                    let reset = level == 0.0 && self.last_sent_level != 0.0;
+                    if due || reset {
+                        self.write_event().await?;
+                        self.last_level_event_at = now;
+                        self.last_sent_level = level;
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
+
+    async fn write_event(&mut self) -> anyhow::Result<()> {
+        let event = LevelEvent {
+            state: self.state,
+            level: self.level.clamp(0.0, 1.0),
+        };
+        let mut line = serde_json::to_string(&event)?;
+        line.push('\n');
+        self.stream.write_all(line.as_bytes()).await?;
+        Ok(())
+    }
+}
