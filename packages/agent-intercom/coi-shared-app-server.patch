+export function resolveSharedAppServerSocketPath(value: string | undefined): string | undefined {
+  if (!value) return undefined;
+  const unixPrefix = "unix://";
+  if (value.startsWith(unixPrefix)) {
+    const socketPath = value.slice(unixPrefix.length);
+    if (!socketPath.startsWith("/")) {
+      throw new Error("shared app-server socket must be an absolute path or unix:// URI");
+    }
+    return socketPath;
+  }
+  return resolve(value);
+}
