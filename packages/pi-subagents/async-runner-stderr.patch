+const ASYNC_RUNNER_STDERR_LOG = "runner-stderr.log";
+const MAX_ASYNC_RUNNER_STDERR_BYTES = 64 * 1024;
+
+function asyncRunnerStderrPath(cfg: object): string | undefined {
+	const asyncDir = (cfg as { asyncDir?: unknown }).asyncDir;
+	return typeof asyncDir === "string" && asyncDir.length > 0
+		? path.join(asyncDir, ASYNC_RUNNER_STDERR_LOG)
+		: undefined;
+}
+
+function boundAsyncRunnerStderrLog(stderrPath: string): void {
+	try {
+		const size = fs.statSync(stderrPath).size;
+		if (size <= MAX_ASYNC_RUNNER_STDERR_BYTES) return;
+		const marker = Buffer.from("[pi-subagents] runner stderr truncated; retaining final bytes\n", "utf-8");
+		const retained = Buffer.alloc(MAX_ASYNC_RUNNER_STDERR_BYTES - marker.length);
+		const descriptor = fs.openSync(stderrPath, "r");
+		try {
+			fs.readSync(descriptor, retained, 0, retained.length, size - retained.length);
+		} finally {
+			fs.closeSync(descriptor);
+		}
+		fs.writeFileSync(stderrPath, Buffer.concat([marker, retained]), { mode: 0o600 });
+	} catch {
+		// Runner stderr is diagnostic only and must not change async execution.
+	}
+}
+
 /**
  * Spawn the async runner process
  */
