+import assert from "node:assert/strict";
+import test from "node:test";
+import { acceptanceFailureMessage, evaluateAcceptance, resolveEffectiveAcceptance } from "../../src/runs/shared/acceptance.ts";
+
+const readOnlyReport = (changedFiles?: string[], testsAddedOrUpdated?: string[]) => ({
+	criteriaSatisfied: [{ id: "criterion-1", status: "satisfied" as const, evidence: "Read-only findings returned." }],
+	...(changedFiles === undefined ? {} : { changedFiles }),
+	...(testsAddedOrUpdated === undefined ? {} : { testsAddedOrUpdated }),
+	commandsRun: [{ command: "node --test", result: "passed" as const, summary: "targeted validation" }],
+	validationOutput: ["Read-only validation completed."],
+	residualRisks: [],
+	noStagedFiles: true,
+});
+
+test("reviewed read-only work accepts explicit empty change evidence", async () => {
+	const acceptance = resolveEffectiveAcceptance({
+		explicit: { level: "reviewed", review: { required: false } },
+		agentName: "scout",
+		task: "Inspect the implementation. Do not edit files.",
+	});
+	const ledger = await evaluateAcceptance({
+		acceptance,
+		output: "",
+		cwd: process.cwd(),
+		report: readOnlyReport([], []),
+	});
+	assert.equal(ledger.status, "checked");
+	assert.deepEqual(
+		ledger.runtimeChecks.filter((check) => check.id.startsWith("evidence:") && check.status === "failed"),
+		[],
+	);
+});
+
+test("reviewed background scout with blocked validation is completed", async () => {
+	const acceptance = resolveEffectiveAcceptance({
+		explicit: "reviewed",
+		agentName: "scout",
+		task: "Inspect the implementation. Do not edit files, do not add tests, and do not create an output artifact.",
+		async: true,
+	});
+	const report = {
+		...readOnlyReport([], []),
+		commandsRun: [{ command: "nix build .#check", result: "blocked" as const, summary: "Nested checkout is unavailable to Nix." }],
+	};
+	const ledger = await evaluateAcceptance({
+		acceptance,
+		output: `Findings returned.\n\n\`\`\`acceptance-report\n${JSON.stringify(report)}\n\`\`\``,
+		cwd: process.cwd(),
+	});
+	assert.deepEqual(acceptance.inferredReason, ["read-only/reviewer-style agent"]);
+	assert.deepEqual(acceptance.review, { required: false });
+	assert.equal(ledger.status, "checked");
+	assert.equal(acceptanceFailureMessage(ledger), undefined);
+});
+
+test("required reviewer still rejects a reviewed run without review evidence", async () => {
+	const acceptance = resolveEffectiveAcceptance({
+		explicit: { level: "reviewed", review: { required: true } },
+		agentName: "scout",
+		task: "Inspect the implementation. Do not edit files.",
+	});
+	const ledger = await evaluateAcceptance({
+		acceptance,
+		output: "",
+		cwd: process.cwd(),
+		report: readOnlyReport([], []),
+	});
+	assert.equal(ledger.status, "rejected");
+	assert.match(acceptanceFailureMessage(ledger) ?? "", /review required/);
+});
+
+test("missing change evidence remains rejected", async () => {
+	const acceptance = resolveEffectiveAcceptance({
+		explicit: { level: "checked" },
+		agentName: "worker",
+		task: "Implement the requested change.",
+	});
+	const ledger = await evaluateAcceptance({
+		acceptance,
+		output: "",
+		cwd: process.cwd(),
+		report: readOnlyReport(undefined, []),
+	});
+	assert.equal(ledger.status, "rejected");
+	assert.match(
+		ledger.runtimeChecks.find((check) => check.id === "evidence:changed-files")?.message ?? "",
+		/missing/,
+	);
+});
